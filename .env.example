# Server-side Supabase Postgres settings; copy to .env and fill these in locally.
# From Dashboard > Connect > Direct connection (or Session pooler for IPv4),
# copy the HOST, PORT and USER. Do not paste a password into DATABASE_URL.
# Example format: jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=4

# Download the project's server root certificate from Database Settings.
# This is the host-side file path; Compose mounts it read-only into the API.
SUPABASE_CA_CERT_PATH=./secrets/supabase-ca.crt
API_BIND_ADDRESS=
API_PORT=

# Only needed for the optional local MinIO / Mailpit tools.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MAILPIT_WEB_PORT=
MAILPIT_SMTP_PORT=
